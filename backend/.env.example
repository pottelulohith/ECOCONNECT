# ── Server
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoconnect?retryWrites=true&w=majority

# ── JWT
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=7d

# ── Client origin (Vite dev server)
CLIENT_URL=http://localhost:5173

# ── Cookie
COOKIE_NAME=ecocivic_session

# ── Cloudinary (optional — image uploads disabled when missing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Seed: initial municipality admin
SEED_ADMIN_EMAIL=admin@ecoconnect.local
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_ADMIN_NAME=Officer R. Vance
